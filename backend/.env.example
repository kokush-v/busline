ENVIRONMENT=dev
DATABASE_URL=postgresql://root:password@db.example.internal:5432/busline
LOG_LEVEL=DEBUG
OBSERVABILITY_LOGS_IN_JSON=true

# AWS Credentials
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# AWS Region
AWS_REGION=us-east-1

# Custom App Configuration
S3_PHOTOS_BUCKET=busline-photos-original
S3_THUMBNAILS_BUCKET=busline-photos-thumbnails
S3_PRESIGNED_URL_EXPIRATION=3600